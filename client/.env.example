# Where the admin API lives. Same value as the website's VITE_API_URL.
#
# Read at BUILD time — Vite bakes it into the bundle, so changing it means
# rebuilding, not restarting.
VITE_API_URL=https://sgd-api.onrender.com

# Where the public website lives.
#
# Some rows point at files the website ships itself (/media/founder.jpg and the
# seeded banners). The API has never had those files, so the panel resolves
# /media/… against this instead — without it those thumbnails are broken.
VITE_SITE_URL=https://sgdelectric.in
