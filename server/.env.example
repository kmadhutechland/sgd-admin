# Signs admin login tokens.
#
# MUST be set before this is reachable from the internet. Without it the server
# falls back to a secret that is printed in the source, and anyone who has read
# the repository can forge a login token and edit the website. The server warns
# at boot when it is missing.
#
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# The first admin account, created by `npm run seed`. Only read on the very
# first run — changing these later does not change an existing password.
ADMIN_EMAIL=admin@sgdlogistics.in
ADMIN_PASSWORD=

# Port to listen on. Most hosts set this themselves.
PORT=4000
